
<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="8.5" name="larp-os-fedora">

    <description type="system">
        <author>larp.os-fedora</author>
        <contact>Project Maintainer</contact>
        <specification>
            larp.os-fedora - Fedora KDE Live System
        </specification>
    </description>

    <preferences>
        <version>0.1.0</version>
        <packagemanager>dnf</packagemanager>
        <rpm-check-signatures>true</rpm-check-signatures>
        <type image="iso" primary="true" flags="overlay"/>
    </preferences>

    <users>
        <user name="liveuser"
              home="/home/liveuser"
              groups="wheel"
              password="larp-live"
              passwordformat="plain"/>
    </users>

    <packages type="image">
        <package name="kernel"/>
        <package name="systemd"/>
        <package name="NetworkManager"/>
        <package name="firewalld"/>
        <package name="sudo"/>
        <package name="dnf5"/>
        <package name="grub2-efi-x64"/>
        <package name="shim-x64"/>

        <package name="plasma-desktop"/>
        <package name="sddm"/>
        <package name="dolphin"/>
        <package name="konsole"/>
        <package name="kate"/>

        <package name="firefox"/>
        <package name="flatpak"/>
        <package name="pipewire"/>
        <package name="wireplumber"/>
    </packages>

</image>
